# Ortam: staging (varsayılan) | production
NEXT_PUBLIC_SITE_ENV=staging
NEXT_PUBLIC_SITE_URL=https://amanahpartners.net

# [KARAR 3, 4] Telegram ve e-posta (kullanıcı adı @ olmadan)
NEXT_PUBLIC_TELEGRAM_SUPPORT=
NEXT_PUBLIC_TELEGRAM_CHANNEL=
NEXT_PUBLIC_CONTACT_EMAIL=

# Form verisi: Supabase (AB bölgesi). Service role anahtarı yalnızca sunucuda; asla NEXT_PUBLIC_ ile başlamaz.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# IP özetleri için rastgele, gizli değer (ör. openssl rand -hex 32)
LEAD_HASH_SALT=

# İsteğe bağlı: yeni başvuruda ekibe Telegram bildirimi
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# İsteğe bağlı: çerezsiz analitik (Plausible)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.outbound-links.tagged-events.js

# Kapı 1: avukat onayı tamamlanınca "yes" (canlı derleme bunu ister)
LEGAL_APPROVED=
